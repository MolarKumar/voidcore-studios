---
/* src/components/TeamCard.astro */
const { name, role, bio } = Astro.props;
---

<div class="team-card">
  <div class="avatar-container">
    <div class="avatar-placeholder">
      <span class="avatar-icon">👤</span>
    </div>
  </div>
  
  <div class="team-info">
    <h3>{name}</h3>
    <span class="team-role">{role}</span>
    <p class="team-bio">{bio}</p>
  </div>
</div>

<style>
  .team-card {
    background-color: var(--color-obsidian);
    border-radius: var(--radius-md);
    border: 1px solid rgba(148, 161, 178, 0.1);
    padding: 2rem;
    text-align: center;
    transition: var(--transition-fast);
  }

  .team-card:hover {
    border-color: rgba(59, 130, 246, 0.3);
    transform: translateY(-5px);
  }

  .avatar-container {
    width: 120px;
    height: 120px;
    margin: 0 auto 1.5rem auto;
    border-radius: 50%;
    padding: 5px;
    background: linear-gradient(135deg, var(--color-core-azure) 0%, transparent 100%);
  }

  .avatar-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-void-black);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
  }

  .team-info h3 {
    margin-bottom: 0.2rem;
    font-size: 1.4rem;
  }

  .team-role {
    display: block;
    color: var(--color-core-azure);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .team-bio {
    font-size: 0.95rem;
    margin-bottom: 0;
  }
</style>