---
/* src/components/JobCard.astro */
const { title, type, department, description } = Astro.props;
---

<div class="job-card">
  <div class="job-header">
    <h3>{title}</h3>
    <div class="job-tags">
      <span class="tag department">{department}</span>
      <span class="tag type">{type}</span>
    </div>
  </div>
  <p>{description}</p>
  <a href="/contact" class="btn-secondary">Apply Now</a>
</div>

<style>
  .job-card {
    background-color: var(--color-obsidian);
    border: 1px solid rgba(148, 161, 178, 0.1);
    border-radius: var(--radius-md);
    padding: 2rem;
    transition: var(--transition-fast);
  }

  .job-card:hover {
    border-color: var(--color-core-azure);
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .job-header h3 {
    margin-bottom: 0;
    font-size: 1.4rem;
  }

  .job-tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.8rem;
    padding: 0.3rem 0.8rem;
    border-radius: 50px;
    font-weight: 600;
  }

  .department {
    background-color: rgba(59, 130, 246, 0.1);
    color: var(--color-core-azure);
  }

  .type {
    background-color: rgba(248, 249, 250, 0.05);
    color: var(--color-steel-gray);
  }

  .job-card p {
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .btn-secondary {
    display: inline-block;
    background-color: transparent;
    color: var(--color-ghost-white);
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    border: 1px solid var(--color-steel-gray);
    transition: var(--transition-fast);
  }

  .btn-secondary:hover {
    border-color: var(--color-ghost-white);
  }
</style>