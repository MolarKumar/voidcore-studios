---
/* src/pages/admin.astro */
---
export const prerender = false; // CRITICAL: Fetches fresh database rows on every single page view

import Layout from '../layouts/Layout.astro';
import { supabaseAdmin } from '../lib/supabase';

// Fetch all reports and applications directly from the server side
const { data: submissions, error } = await supabaseAdmin
  .from('submissions')
  .select('*')
  .order('created_at', { ascending: false });
---

<Layout title="Admin Panel | VoidCore Studios">
  <main style="padding: 2rem; max-width: 1200px; margin: 0 auto;">
    <h2>Studio Submissions Dashboard</h2>
    <p>Real-time overview of contact forms, job applications, and system reports.</p>

    {error && (
      <div style="background: #ff5252; color: white; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;">
        <strong>Database Connection Error:</strong> {error.message}
      </div>
    )}

    {(!submissions || submissions.length === 0) ? (
      <p style="color: #666; font-style: italic;">No form submissions found in the database yet.</p>
    ) : (
      <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem;">
        {submissions.map((item) => (
          <div style="background: #1e1e24; border: 1px solid #333; padding: 1.5rem; border-radius: 8px; color: #fff;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 0.5rem; margin-bottom: 1rem;">
              <h3 style="margin: 0; color: #4fc3f7;">{item.name}</h3>
              <span style="background: #334155; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.85rem; text-transform: uppercase;">
                {item.type}
              </span>
            </div>
            
            <p style="margin: 0.5rem 0;"><strong>Email:</strong> <a href={`mailto:${item.email}`} style="color: #4df;">{item.email}</a></p>
            <p style="margin: 0.5rem 0;"><strong>Message/Description:</strong></p>
            <blockquote style="background: #0f0f12; margin: 0.5rem 0; padding: 1rem; border-left: 4px solid #4fc3f7; border-radius: 4px;">
              {item.message}
            </blockquote>

            {item.metadata && (
              <div style="margin-top: 1rem; background: #111; padding: 0.75rem; border-radius: 4px;">
                <strong style="font-size: 0.9rem; color: #aaa;">Application / Report Meta Metadata:</strong>
                <pre style="margin: 0.5rem 0 0 0; font-size: 0.85rem; color: #81c784; overflow-x: auto;">
                  {JSON.stringify(item.metadata, null, 2)}
                </pre>
              </div>
            )}
            
            <div style="margin-top: 1rem; text-align: right;">
              <small style="color: #666;">Submitted: {new Date(item.created_at).toLocaleString()}</small>
            </div>
          </div>
        ))}
      </div>
    )}
  </main>
</Layout>

// 2. Check if user is authenticated
const isAuthenticated = Astro.cookies.has(COOKIE_NAME);
let submissions = [];

// 3. Fetch data ONLY if they are logged in
if (isAuthenticated) {
  const { data, error } = await supabase
    .from('contact_submissions')
    .select('*')
    .order('created_at', { ascending: false });
    
  if (!error) submissions = data;
}
---

<Layout title="System Administration">
  <main class="admin-container fade-in-load">
    
    {!isAuthenticated ? (
      <div class="admin-card login-box">
        <div class="admin-header">
          <span class="studio-logo">Restricted Area</span>
          <h1>Admin Override</h1>
          <p>Enter the master password to access server logs.</p>
        </div>

        <form method="POST" class="auth-form">
          <input type="hidden" name="action" value="login" />
          <div class="form-group">
            <input type="password" name="password" required placeholder="Enter Passphrase..." autofocus />
          </div>
          {errorMessage && <div class="error-toast">{errorMessage}</div>}
          <button type="submit" class="btn-primary auth-btn">Bypass Security</button>
        </form>
      </div>
    ) : (
      <div class="dashboard-wrapper">
        <header class="dashboard-header">
          <div>
            <h1>Command Center</h1>
            <p>Incoming Transmissions ({submissions.length})</p>
          </div>
          <form method="POST">
            <input type="hidden" name="action" value="logout" />
            <button type="submit" class="logout-btn">Disconnect</button>
          </form>
        </header>

        <div class="submissions-grid">
          {submissions.length === 0 ? (
            <div class="empty-state">No transmissions received yet.</div>
          ) : (
            submissions.map((sub) => (
              <div class="message-card">
                <div class="card-header">
                  <div class="badge">
                    {sub.subject.toUpperCase()}
                  </div>
                  <span class="date">
                    {new Date(sub.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })}
                  </span>
                </div>
                <div class="card-body">
                  <h3 class="sender-name">{sub.name}</h3>
                  <a href={`mailto:${sub.email}`} class="sender-email">{sub.email}</a>
                  <div class="message-content">
                    <p>{sub.message}</p>
                  </div>
                </div>
              </div>
            ))
          )}
        </div>
      </div>
    )}

  </main>
</Layout>

<style>
  /* --- Global Admin Layout --- */
  .admin-container {
    min-height: 100vh;
    padding: 6rem 2rem;
    background-color: var(--color-void-black);
    color: var(--color-ghost-white);
  }

  /* --- Login Box Styling --- */
  .login-box {
    max-width: 400px;
    margin: 0 auto;
    background-color: var(--color-obsidian);
    padding: 3rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(239, 68, 68, 0.2);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    text-align: center;
  }

  .admin-header h1 {
    font-size: 1.5rem;
    margin: 0.5rem 0;
  }

  .admin-header p {
    color: var(--color-steel-gray);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .studio-logo {
    color: #ef4444;
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  input[type="password"] {
    width: 100%;
    padding: 1rem;
    background-color: var(--color-void-black);
    border: 1px solid rgba(148, 161, 178, 0.2);
    border-radius: var(--radius-sm);
    color: white;
    margin-bottom: 1rem;
  }

  .auth-btn {
    width: 100%;
    padding: 1rem;
    background-color: #ef4444;
    color: white;
    border: none;
    border-radius: var(--radius-sm);
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .auth-btn:hover { background-color: #dc2626; }

  .error-toast {
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.1);
    padding: 0.8rem;
    border-radius: 4px;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  /* --- Dashboard Styling --- */
  .dashboard-wrapper {
    max-width: 1200px;
    margin: 0 auto;
  }

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(148, 161, 178, 0.2);
    padding-bottom: 1.5rem;
    margin-bottom: 3rem;
  }

  .dashboard-header p {
    color: var(--color-core-azure);
    font-weight: 600;
  }

  .logout-btn {
    background: transparent;
    border: 1px solid rgba(148, 161, 178, 0.3);
    color: var(--color-steel-gray);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .logout-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    color: white;
  }

  .submissions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .message-card {
    background-color: var(--color-obsidian);
    border: 1px solid rgba(148, 161, 178, 0.1);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(148, 161, 178, 0.1);
    padding-bottom: 1rem;
  }

  .badge {
    background-color: rgba(59, 130, 246, 0.1);
    color: var(--color-core-azure);
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
  }

  .date {
    color: var(--color-steel-gray);
    font-size: 0.8rem;
  }

  .sender-name {
    font-size: 1.2rem;
    margin-bottom: 0.2rem;
  }

  .sender-email {
    color: var(--color-core-azure);
    font-size: 0.9rem;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .message-content {
    background-color: var(--color-void-black);
    padding: 1rem;
    border-radius: 4px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #d1d5db;
    white-space: pre-wrap;
    flex-grow: 1;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem;
    color: var(--color-steel-gray);
    background: var(--color-obsidian);
    border-radius: 8px;
    border: 1px dashed rgba(148, 161, 178, 0.2);
  }
</style>