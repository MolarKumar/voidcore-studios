---
export const prerender = false; // CRITICAL: Fetches fresh database rows on every single page view

import Layout from '../layouts/Layout.astro';
import { supabaseAdmin } from '../lib/supabase';

// Bypass Astro's colon parsing bug
const ascending = false;

// Fetch all reports and applications directly from the server side
const response = await supabaseAdmin
  .from('submissions')
  .select('*')
  .order('created_at', { ascending });

const submissions = response.data || [];
---

<Layout title="System Administration | VoidCore Studios">
  <main class="admin-container fade-in-load">
    <div class="dashboard-wrapper">
      <header class="dashboard-header">
        <div>
          <h1>Command Center</h1>
          <p>Incoming Transmissions ({submissions.length})</p>
        </div>
      </header>

      <div class="submissions-grid">
        {submissions.length === 0 ? (
          <div class="empty-state">No transmissions received yet.</div>
        ) : (
          submissions.map((sub) => (
            <div class="message-card">
              <div class="card-header">
                <div class="badge">
                  {sub.type ? sub.type.toUpperCase() : 'UNKNOWN'}
                </div>
                <span class="date">
                  {new Date(sub.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })}
                </span>
              </div>
              <div class="card-body">
                <h3 class="sender-name">{sub.name}</h3>
                <a href={`mailto:${sub.email}`} class="sender-email">{sub.email}</a>
                <div class="message-content">
                  <p>{sub.message}</p>
                </div>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </main>
</Layout>

<style>
  /* --- Global Admin Layout --- */
  .admin-container {
    min-height: 100vh;
    padding: 6rem 2rem;
    background-color: var(--color-void-black);
    color: var(--color-ghost-white);
  }

  /* --- Dashboard Styling --- */
  .dashboard-wrapper {
    max-width: 1200px;
    margin: 0 auto;
  }

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(148, 161, 178, 0.2);
    padding-bottom: 1.5rem;
    margin-bottom: 3rem;
  }

  .dashboard-header p {
    color: var(--color-core-azure);
    font-weight: 600;
  }

  .submissions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .message-card {
    background-color: var(--color-obsidian);
    border: 1px solid rgba(148, 161, 178, 0.1);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(148, 161, 178, 0.1);
    padding-bottom: 1rem;
  }

  .badge {
    background-color: rgba(59, 130, 246, 0.1);
    color: var(--color-core-azure);
    font-size: 0.75rem;
    font-weight: bold;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
  }

  .date {
    color: var(--color-steel-gray);
    font-size: 0.8rem;
  }

  .sender-name {
    font-size: 1.2rem;
    margin-bottom: 0.2rem;
  }

  .sender-email {
    color: var(--color-core-azure);
    font-size: 0.9rem;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .message-content {
    background-color: var(--color-void-black);
    padding: 1rem;
    border-radius: 4px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #d1d5db;
    white-space: pre-wrap;
    flex-grow: 1;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem;
    color: var(--color-steel-gray);
    background: var(--color-obsidian);
    border-radius: 8px;
    border: 1px dashed rgba(148, 161, 178, 0.2);
  }
</style>