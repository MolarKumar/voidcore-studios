---
import Layout from '../layouts/Layout.astro';
// All backend, form processing, and database imports have been permanently removed.
---

<Layout title="Contact Us | VoidCore Studios">
  <main class="contact-container fade-in-load">
    <div class="contact-wrapper">
      <header class="contact-header">
        <span class="studio-logo">Get In Touch</span>
        <h1>Contact VoidCore Studios</h1>
        <p>Reach out to us directly through any of our official channels below.</p>
      </header>

      <div class="contact-grid">
        <button 
         onclick="window.location.href='mailto:support.voidcore@gmail.com';" 
         class="contact-card"
         style="cursor: pointer; width: 100%; border: none; font-family: inherit;"
        >
         <div class="card-icon">✉️</div>
         <h3>Email</h3>
         <p>support.voidcore@gmail.com</p>
        </button> 

        <a href="https://discord.gg/your-invite-code" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="card-icon">💬</div>
          <h3>Discord</h3>
          <p>Join our official community</p>
        </a>

        <a href="https://youtube.com/@VoidCoreStudios" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="card-icon">📺</div>
          <h3>YouTube</h3>
          <p>Watch our devlogs & trailers</p>
        </a>

        <a href="https://roblox.com/groups/your-group-id" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="card-icon">🎮</div>
          <h3>Roblox Group</h3>
          <p>Play our latest experiences</p>
        </a>

        <a href="https://x.com/VoidCoreStudios" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="card-icon">🐦</div>
          <h3>X (Twitter)</h3>
          <p>Follow for quick updates</p>
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* --- Global Contact Layout --- */
  .contact-container {
    min-height: 100vh;
    padding: 6rem 2rem;
    background-color: var(--color-void-black, #0f0f12);
    color: var(--color-ghost-white, #f8fafc);
  }

  .contact-wrapper {
    max-width: 1000px;
    margin: 0 auto;
  }

  /* --- Header Styling --- */
  .contact-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .studio-logo {
    color: #ef4444;
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-size: 0.9rem;
  }

  .contact-header h1 {
    font-size: 2.5rem;
    margin: 1rem 0;
  }

  .contact-header p {
    color: var(--color-steel-gray, #94a1b2);
    font-size: 1.1rem;
  }

  /* --- Grid & Card Styling --- */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .contact-card {
    background-color: var(--color-obsidian, #1e1e24);
    border: 1px solid rgba(148, 161, 178, 0.1);
    border-radius: 8px; 
    padding: 2.5rem 1.5rem;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .contact-card:hover {
    transform: translateY(-5px);
    border-color: rgba(79, 195, 247, 0.4); 
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  }

  .card-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .contact-card h3 {
    margin: 0 0 0.5rem 0;
    color: #4fc3f7; 
    font-size: 1.3rem;
  }

  .contact-card p {
    margin: 0;
    color: var(--color-steel-gray, #94a1b2);
    font-size: 0.95rem;
  }
</style>